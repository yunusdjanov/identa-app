EXPO_PUBLIC_API_URL=http://10.0.2.2:8001/api/v1

# Mocks are opt-in: only explicit `true` enables them. Per-resource overrides
# (EXPO_PUBLIC_MOCK_PATIENTS, etc.) can enable one slice during debugging.
EXPO_PUBLIC_USE_MOCK_API=false

# Sentry DSN — leave empty to disable crash reporting in dev/preview.
# Production builds should set this via EAS secrets (`eas secret:create`).
EXPO_PUBLIC_SENTRY_DSN=
